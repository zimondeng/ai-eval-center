# Docker Compose 环境变量示例（按需复制为 .env 并修改）
# 注意：docker-compose.yml 已内置开箱即用的默认值，不创建 .env 也可直接启动

# 应用与数据库对外映射端口（默认 23306 以避开宿主机常见 3306/13306 端口冲突）
APP_PORT=18200
MYSQL_PORT=23306

# MySQL 容器 root 密码（库名固定为 kd_eval，对应 docs/sql/01_schema.sql）
MYSQL_ROOT_PASSWORD=root

# 应用运行环境与安全密钥（生产环境请务必替换为高强度随机密钥）
APP_ENV=prod
AUTO_INIT_DB=true
JWT_SECRET=ai-eval-center-dev-jwt-secret-key-2026
MASTER_ENCRYPTION_KEY=ai-eval-center-dev-master-key-32

# 默认管理员账号（仅首次空库初始化时生效）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

# 如需连接外部数据脱敏中心或宿主机代理，请使用 host.docker.internal 访问宿主机
DESENSITIZE_BASE_URL=http://host.docker.internal:18100
DESENSITIZE_API_KEY=
PROXY_CANDIDATES=["http://host.docker.internal:10808","http://host.docker.internal:7897"]

# 可选：被测系统与第三方判别渠道环境变量引用（ENV_REF）
# 注意：留空会覆盖宿主机同名的系统环境变量，若已在宿主机配置可保持注释状态
# EMRANK_API_KEY=
# TYPESAFE_API_KEY=
# EVAL_JAVA_BEARER_TOKEN=
# ROUTING_EVAL_HARNESS_TOKEN=
